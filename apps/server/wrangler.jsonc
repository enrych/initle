{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "initle",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Per-IP limits for the write endpoints (Workers Rate Limiting binding). Room sockets are limited in the reducer.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "GUESS_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "initle",
      // No database_id: Wrangler creates the database on first deploy (automatic provisioning)
      // and keeps it linked afterwards. The Worker creates its own tables (src/db.ts).
      "migrations_dir": "migrations"
    }
  ]
}
